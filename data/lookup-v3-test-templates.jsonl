{"id": "T3-003", "group": "my_requests", "template": "where is my most recent request at?", "tool": "my_requests", "args": {"which": "latest"}, "choice": {"tool": "my_requests", "which": "latest"}}
{"id": "T3-004", "group": "my_requests", "template": "are any of my requests still in progress", "tool": "my_requests", "args": {"which": "open"}, "choice": {"tool": "my_requests", "which": "open"}}
{"id": "T3-005", "group": "my_requests", "template": "anything I have to reply to?", "tool": "my_requests", "args": {"which": "waiting"}, "choice": {"tool": "my_requests", "which": "waiting"}}
{"id": "T3-006", "group": "my_requests", "template": "update on R-00031?", "tool": "my_requests", "args": {"id": "R-00031"}, "choice": {"tool": "my_requests", "request_id": "R31"}}
{"id": "T3-007", "group": "my_rules", "template": "list the timetable preferences I've given", "tool": "my_rules", "args": {}, "choice": {"tool": "my_rules"}}
{"id": "T3-008", "group": "clash_check", "template": "is there any overlap between {section.any} and {section2.any} {when}?", "tool": "clash_check", "args": {"sections": ["{section}", "{section2}"]}, "choice": {"tool": "clash_check", "sections": ["{section}", "{section2}"]}}
{"id": "T3-009", "group": "move_options", "template": "what slots could my {my_course.any} class be moved into {when}?", "tool": "move_options", "args": {}, "choice": {"tool": "move_options", "course": "{my_course}"}}
{"id": "T3-010", "group": "counts", "template": "which teacher has the heaviest load {when}?", "tool": "counts", "args": {"of": "teachers", "measure": "teaching_hours", "order": "most"}, "choice": {"tool": "counts", "of": "teachers", "measure": "teaching_hours", "order": "most"}}
{"id": "T3-011", "group": "counts", "template": "number of classes per section {when}", "tool": "counts", "args": {"of": "sections", "measure": "classes"}, "choice": {"tool": "counts", "of": "sections", "measure": "classes"}}
{"id": "T3-012", "group": "gaps", "template": "my biggest gap between classes on {day.any}?", "tool": "gaps", "args": {"teachers": ["me"], "days": ["{day}"], "measure": "free"}, "choice": {"tool": "gaps", "teachers": ["me"], "days": ["{day}"], "measure": "free"}}
{"id": "T3-013", "group": "my_fairness", "template": "how often have I had to give up my slot for someone?", "tool": "my_fairness", "args": {}, "choice": {"tool": "my_fairness"}}
{"id": "T3-014", "group": "bookings", "template": "did the music club get the room they asked for?", "tool": "bookings", "args": {"club": "music"}, "choice": {"tool": "bookings", "club": "music"}}
{"id": "T3-015", "group": "what_if", "template": "if my {my_course.any} lecture moved to {day.any}, what else would change?", "tool": "what_if", "args": {}, "choice": {"tool": "what_if", "request": "move my {my_course} lecture to {day}"}}
{"id": "T3-016", "group": "room_for", "template": "would {lab.any} seat {section.any} and {section2.any} at once?", "tool": "free_hours", "args": {"sections": ["{section}", "{section2}"], "rooms": ["{lab}"], "room_for": ["{section}", "{section2}"]}, "choice": {"tool": "free_hours", "sections": ["{section}", "{section2}"], "rooms": ["{lab}"], "room_for": ["{section}", "{section2}"]}}
{"id": "T3-017", "group": "weeks", "template": "do I have a free {day.any} in weeks 6 to 8?", "tool": "free_hours", "args": {"teachers": ["me"], "days": ["{day}"], "weeks": [6, 7, 8]}, "choice": {"tool": "free_hours", "teachers": ["me"], "days": ["{day}"], "weeks": [6, 7, 8]}, "week": 6}
{"id": "T3-018", "group": "separately", "template": "when is {teacher.any}, {teacher2.any} and {teacher3.any} available {when}?", "tool": "free_hours", "args": {"teachers": ["{teacher}", "{teacher2}", "{teacher3}"]}, "split": ["teachers"], "separately": true}
{"id": "T3-019", "group": "together", "template": "when are {section.any} and {section2.any} available together on {day.any}?", "tool": "free_hours", "args": {"sections": ["{section}", "{section2}"], "days": ["{day}"]}}
{"id": "T3-020", "group": "separately", "template": "free hours of {lab.any} and {lab2.any}, each on its own, {when}", "tool": "free_hours", "args": {"rooms": ["{lab}", "{lab2}"]}, "split": ["rooms"], "separately": true}
{"id": "T3-021", "group": "separately", "template": "what classes do {teacher.any} and {teacher2.any} have on {day.any}?", "tool": "classes_of", "args": {"teachers": ["{teacher}", "{teacher2}"], "days": ["{day}"]}, "split": ["teachers"]}
{"id": "T3-022", "group": "together", "template": "when are sections {section.n} and {section2.n} free at the same time {when}?", "tool": "free_hours", "args": {"sections": ["{section}", "{section2}"]}}
{"id": "T3-023", "group": "separately", "template": "separately: when are {section.any} and I free on {day.any}?", "tool": "free_hours", "args": {"teachers": ["me"], "sections": ["{section}"], "days": ["{day}"]}, "split": ["teachers", "sections"], "separately": true}
